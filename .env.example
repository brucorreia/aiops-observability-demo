# Minutes used to decide if a Deployment revision counts as "recent".
# Pod creation time is not used as proof of a deploy.
RECENT_DEPLOYMENT_WINDOW_MINUTES=15

# First version never executes remediation without a human approval.
AUTOMATIC_EXECUTION_ALLOWED=false

# Isolated kubeconfig written by `make cluster`. Do not point this at ~/.kube/config.
# KUBECONFIG=.kube/config

# In-cluster defaults. Override for local runs.
VICTORIAMETRICS_URL=http://vmsingle-vmks.monitoring.svc:8428
VICTORIALOGS_URL=http://vlsingle-vmks.monitoring.svc:9428
KUBERNETES_NAMESPACE=aiops-demo
AGENT_NAMESPACE=monitoring

# Optional second scoring layer. Leave empty for deterministic-only mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
